# Solana Trading Bot Configuration (.env)
# Copy this file to .env and fill in your values
# DO NOT commit .env to version control!

# Wallet Private Key (REQUIRED for live trading)
# Format: JSON array [12,34,...] or base58 string
PRIVATE_KEY=

# Solana RPC Endpoint (default shown)
RPC_ENDPOINT=https://api.mainnet-beta.solana.com

# Trading Parameters
TRADE_SIZE_SOL=0.1
SLIPPAGE_BPS=50
MIN_PROFIT_USD=2

# LIVE TRADING - Set to 'true' ONLY after testing
ENABLE_LIVE=false

# Referral fee account (optional)
REFERRAL_FEE_ACCOUNT=

# Logging level
LOG_LEVEL=info
