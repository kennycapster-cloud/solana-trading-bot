{
  "compilerOptions": {
    "lib": ["dom", "esnext"],
    "strict": true
  },
  "imports": {
    "std/": "https://deno.land/std@0.201.0/",
    "fresh": "https://deno.land/x/fresh@1.6.0/",
    "preact": "https://esm.sh/preact@10.18.1",
    "preact/": "https://esm.sh/preact@10.18.1/"
  },
  "tasks": {
    "build": "deno run -A --no-check=remote jsr:@fresh/build",
    "dev": "deno run -A --watch=static/,routes/ dev.ts",
    "preview": "deno run -A src/index.ts",
    "start": "deno run -A src/index.ts"
  },
  "exclude": ["./dist/", "./build/"]
}
