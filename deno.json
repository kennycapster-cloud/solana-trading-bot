{
  "compilerOptions": {
    "lib": ["esnext"],
    "strict": true
  },
  "imports": {
    "std/": "https://deno.land/std@0.201.0/"
  },
  "tasks": {
    "dev": "deno run --allow-net --allow-env --allow-read --watch=src src/index.ts",
    "start": "deno run --allow-net --allow-env --allow-read src/index.ts",
    "local": "deno run --allow-net --allow-env --allow-read scripts/local_runner.ts"
  },
  "exclude": ["./dist/", "./build/"]
}
